# TechScroll enrichment pipeline secrets. Copy to .env.local (gitignored).
# AI summaries via NVIDIA Nemotron on the public integrate endpoint.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional tuning for scripts/enrich.mjs
# ENRICH_MAX=50          # max NEW articles to AI-summarize per run
# ENRICH_CONCURRENCY=4   # parallel LLM calls

# Privacy-gated Vercel Web Analytics (disabled unless explicitly true)
LEARNIFY_ANALYTICS_ENABLED=false

# Optional OpenAlex topic-feed configuration (public access currently works without either).
# OPENALEX_API_KEY=replace-with-provider-key
# OPENALEX_MAILTO=support@example.com

# Apify - Google Scholar research tier. Used ONLY by scripts/snapshot-scholar.mjs
# (and by the optional live lane below); the request path reads the committed
# scholar-snapshot.json, so the serverless functions need no Apify credential.
# Get a token at https://console.apify.com/settings/integrations
APIFY_TOKEN=apify_api_REPLACE_WITH_YOUR_TOKEN
# SCHOLAR_MAX_PER_SEARCH=10   # papers per query (cost is $0.0015 per paper)
# SCHOLAR_BUDGET_USD=1.00     # hard per-run ceiling, enforced locally AND by Apify
# SCHOLAR_TOPICS=             # comma-separated topic labels; empty = all 23
